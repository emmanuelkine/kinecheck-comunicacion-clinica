/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-site
  X-Frame-Options: SAMEORIGIN
  X-Permitted-Cross-Domain-Policies: none

/platform/*
  Cache-Control: private, no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/platform/security-bootstrap.js
  Cache-Control: private, no-store, max-age=0

/admin/*
  Cache-Control: private, no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/kinecheck-clinico-curso/*
  Cache-Control: private, no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/kinecheck-clinico-guia/*
  Cache-Control: private, no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/academy/academy-open-v6.js
  Cache-Control: private, no-store, max-age=0

/academy/academy-launch-router-v4.js
  Cache-Control: private, no-store, max-age=0

/academy/academy-integration-guard-v4.js
  Cache-Control: private, no-store, max-age=0

/academy/academy-brand-identity.js
  Cache-Control: private, no-store, max-age=0

/academy/*
  Cache-Control: no-cache, must-revalidate
  X-Robots-Tag: noindex, nofollow

/beta/*
  Cache-Control: no-cache, must-revalidate

/ayuda/*
  Cache-Control: public, max-age=3600, must-revalidate

/bienvenida/*
  Cache-Control: public, max-age=3600, must-revalidate

/soporte/*
  Cache-Control: no-cache, must-revalidate

/legal/*
  Cache-Control: public, max-age=3600, must-revalidate

/404.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: noindex, follow

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

/*.html
  Cache-Control: no-cache, must-revalidate

/*.js
  Cache-Control: no-cache, must-revalidate

/academy/*.js
  Cache-Control: no-cache, must-revalidate

/traumatologia/*.js
  Cache-Control: no-cache, must-revalidate
