d31}\n.kc-cert-button{box-shadow:inset 0 2px 0 rgba(255,255,255,.5),inset 0 -4px 0 rgba(5,91,96,.22),0 8px 18px rgba(0,0,0,.23);text-shadow:0 1px 0 rgba(255,255,255,.3)}\n@media(max-width:600px){.kc-cert-info h2{font-size:clamp(1.2rem,5.1vw,1.45rem);line-height:1.38}.hero h1{font-size:clamp(1.75rem,7vw,2.45rem)}.kc-audience-grid a span:nth-child(2){font-size:clamp(1.5rem,6vw,1.85rem)!important}}\n@media(prefers-reduced-motion:reduce){.hero h1,.kc-cert-info h2,#elige-biblioteca h2,.kc-audience-grid a span:nth-child(2){filter:none}}\n</style><style id="kc-original-wordmark">.kc-library-heading{display:flex;flex-direction:column;align-items:center;gap:13px}.kc-library-heading .kc-library-wordmark{display:block;width:min(440px,85%);height:auto;max-width:100%;filter:none;-webkit-text-fill-color:initial;background:none}.kc-library-heading span{display:block}@media(max-width:600px){.kc-library-heading .kc-library-wordmark{width:min(320px,88%)}}</style></head><body><header class="top"><div class="wrap"><a href="/" aria-label="KineCheck inicio"><img src="/assets/brand/kinecheck-3d-compact.webp" alt="KineCheck"></a><a href="/">Volver a KineCheck</a></div></header><main class="wrap"><div class="hero"><span class="eyebrow">ACCESO LIBRE · SIN PAGO NI REGISTRO</span><h1 class="kc-library-heading"><span>Biblioteca gratuita</span><img class="kc-library-wordmark" src="/assets/brand/kinecheck-3d-compact.webp" alt="KineCheck" width="720" height="111" decoding="async"></h1><p>Selecciona la biblioteca que quieres explorar.</p></div><section aria-label="Horas disponibles en salud" id="horas-disponibles" style="padding:22px 0 16px">\n<div style="border:3px solid #f6d34c;border-radius:24px;padding:clamp(24px,5vw,42px);background:linear-gradient(130deg,#124a4b 0%,#0d333b 55%,#102630 100%);box-shadow:0 15px 45px #0005">\n<span style="display:inline-block;border:1px solid #72e4d4;color:#b9fff1;border-radius:30px;padding:5px 12px;font-size:.77rem;font-weight:800;letter-spacing:.07em">NUEVO · VISTA PREVIA</span>\n<h2 style="font-size:clamp(1.6rem,3.5vw,2.5rem);line-height:1.2;margin:17px 0 10px;color:#f1ffff">¿Buscas una hora con un profesional de salud?</h2>\n<p style="color:#ddf7f4;max-width:800px;font-size:1.08rem;margin:0 0 12px">Encuentra horas disponibles en medicina, kinesiología, nutrición, psicología, terapia ocupacional, enfermería y otras especialidades de salud.</p>\n<p style="color:#b7d9dc;margin:0 0 23px">Todas las profesiones de salud en un solo lugar. Contacta directamente al profesional, sin intermediarios.</p>\n<div style="display:flex;flex-wrap:wrap;gap:13px">\n<a href="/horas-disponibles/#searchPanel" style="background:#6de5d5;color:#07282c;font-weight:900;padding:14px 22px;border-radius:12px;text-decoration:none;display:inline-block">Buscar una hora →</a>\n<a href="/horas-disponibles/#publishPanel" style="border:1px solid #7cdcd5;color:#f2fffc;background:#183e45;font-weight:800;padding:14px 22px;border-radius:12px;text-decoration:none;display:inline-block">Soy profesional →</a>\n</div>\n<p style="font-size:.82rem;color:#bdd8da;margin:17px 0 0">Servicio en etapa piloto. Estamos preparando la publicación de horas disponibles para distintas profesiones de salud.</p>\n</div></section><section aria-label="Selecciona tu biblioteca" id="elige-biblioteca" style="padding:18px 0 42px">\n        <h2 style="margin-bottom:8px">¿Para quién buscas recursos?</h2>\n        <p style="color:#c7e3e5;margin-bottom:22px">Selecciona una de las dos bibliotecas gratuitas.</p>\n        <div class="kc-audience-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px">\n          <a href="/gratis/profesionales/" style="display:block;text-decoration:none;color:#f1fcfc;background:linear-gradient(135deg,#123b45,#0b252e);border:1px solid #43959d;border-radius:20px;padding:26px;min-height:230px">\n            <span style="display:block;font-size:.8rem;color:#9dece7;font-weight:800;letter-spacing:.08em">BIBLIOTECA PROFESIONAL</span>\n            <span style="display:block;font-size:2rem;font-weight:850;line-height:1.2;margin:15px 0">Soy profesional o estudiante</span>\n            <span style="display:block;color:#d0e7e9;margin-bottom:20px">Evidencia científica, razonamiento clínico y herramientas de aprendizaje.</span>\n            <strong style="color:#8be8e4">Explorar recursos profesionales →</strong>\n          </a>\n          <a href="/gratis/pacientes/" style="display:block;text-decoration:none;color:#f1fcfc;background:linear-gradient(135deg,#12564f,#0b3037);border:1px solid #57b8a7;border-radius:20px;padding:26px;min-height:230px">\n            <span style="display:block;font-size:.8rem;color:#9df3d7;font-weight:800;letter-spacing:.08em">BIBLIOTECA PARA PACIENTES</span>\n            <span style="display:block;font-size:2rem;font-weight:850;line-height:1.2;margin:15px 0">Soy paciente o público general</span>\n            <span style="display:block;color:#d0e7e9;margin-bottom:20px">Dolor, movimiento y autocuidado explicados con palabras sencillas.</span>\n            <strong style="color:#9df3d7">Explorar recursos para pacientes →</strong>\n          </a>\n        </div>\n      </section>\n</main><footer class="foot"><div class="wrap"><img src="/assets/brand/kinecheck-3d-compact.webp" alt="KineCheck"><span>Educación basada en evidencia, accesible para todos.</span></div></footer><script defer src="/metrics-v1.js?v=20261021-global-center"></script><script defer src="/assets/library-funnel-v1.js?v=20261011"></script><script defer src="/assets/library-feedback-v1.js?v=20261021-original-no-count"></script></body></html>\n',
